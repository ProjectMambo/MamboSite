{
  "name": "@mambosite/react",
  "version": "0.1.2",
  "description": "Framework-neutral React renderer and component registry for MamboSite.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@mambosite/runtime": "0.1.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0"
  }
}
