{
  "name": "@mambosite/runtime",
  "version": "0.1.2",
  "description": "Framework-neutral contracts and content graph helpers for MamboSite output.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  }
}
