{
  "name": "@mambosite/next",
  "version": "0.1.1",
  "description": "Thin Next.js static-export adapter for the MamboSite React runtime.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@mambosite/react": "0.1.1",
    "@mambosite/runtime": "0.1.1"
  },
  "peerDependencies": {
    "next": ">=16.0.0 <17.0.0",
    "react": ">=19.0.0 <20.0.0"
  }
}
